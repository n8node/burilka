{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@rigintel/classic-rig-runtime": ["./src/index.ts"],
      "@rigintel/classic-rig-runtime/renderer": ["./src/renderer/index.ts"]
    }
  },
  "include": ["src", "tests", "mapping", "examples"]
}
